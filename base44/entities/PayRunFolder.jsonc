{
  "name": "PayRunFolder",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "week_ending": {
      "type": "string",
      "format": "date"
    },
    "pay_cycle": {
      "type": "string",
      "enum": [
        "weekly",
        "fortnightly",
        "monthly"
      ],
      "default": "weekly"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ],
      "default": "open"
    }
  },
  "required": [
    "client_name",
    "week_ending",
    "pay_cycle"
  ]
}