{
  "name": "Candidate",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "QLD",
        "NSW",
        "VIC",
        "WA",
        "SA",
        "TAS",
        "NT",
        "ACT"
      ]
    },
    "trade": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "licences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resume_url": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "fifo_available": {
      "type": "boolean",
      "default": false
    },
    "roster_preference": {
      "type": "string"
    },
    "pay_rate_expectation": {
      "type": "number"
    },
    "availability_date": {
      "type": "string",
      "format": "date"
    },
    "previous_clients": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rating": {
      "type": "number",
      "description": "1-5 rating"
    },
    "notes": {
      "type": "string"
    },
    "pipeline_stage": {
      "type": "string",
      "enum": [
        "new_applicant",
        "resume_review",
        "phone_screen",
        "interview",
        "reference_check",
        "compliance_check",
        "medical_required",
        "ready_for_placement",
        "offered",
        "accepted",
        "mobilising",
        "active",
        "rejected",
        "talent_pool"
      ],
      "default": "new_applicant"
    },
    "candidate_stage": {
      "type": "string",
      "enum": [
        "available",
        "active",
        "applied",
        "mobilising",
        "demobbed",
        "inactive",
        "archived"
      ],
      "default": "available"
    },
    "compliance_status": {
      "type": "string",
      "enum": [
        "compliant",
        "expiring_soon",
        "non_compliant",
        "pending"
      ],
      "default": "pending"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "blacklisted"
      ],
      "default": "active"
    },
    "user_id": {
      "type": "string",
      "description": "Linked user account ID"
    },
    "candidate_id": {
      "type": "string",
      "description": "Display ID e.g. CND-02458"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "other",
        "prefer_not_to_say"
      ]
    },
    "address": {
      "type": "string"
    },
    "home_phone": {
      "type": "string"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "emergency_contact_relationship": {
      "type": "string"
    },
    "notice_period": {
      "type": "string"
    },
    "willing_to_relocate": {
      "type": "boolean",
      "default": false
    },
    "home_airport": {
      "type": "string"
    },
    "applied_date": {
      "type": "string",
      "format": "date"
    },
    "recruiter_name": {
      "type": "string"
    },
    "linkedin_url": {
      "type": "string"
    },
    "facebook_url": {
      "type": "string"
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "interview",
              "phone_call",
              "sms_sent",
              "did_not_answer",
              "general",
              "note"
            ]
          },
          "text": {
            "type": "string"
          },
          "author_name": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      }
    },
    "verifications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string"
          },
          "reference_number": {
            "type": "string"
          },
          "expiry_date": {
            "type": "string",
            "format": "date"
          },
          "date_verified": {
            "type": "string",
            "format": "date"
          },
          "verified_by": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "pending",
              "expired",
              "not_required"
            ],
            "default": "pending"
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "file_name": {
            "type": "string"
          },
          "file_url": {
            "type": "string"
          },
          "uploaded_date": {
            "type": "string",
            "format": "date"
          },
          "expiry_date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "phone_call",
              "interview",
              "sms",
              "note",
              "document_uploaded",
              "verification_completed",
              "stage_changed",
              "email",
              "meeting"
            ]
          },
          "description": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "first_name",
    "last_name",
    "email"
  ]
}