{
  "name": "IdeaBoard",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "idea",
        "change_request",
        "bug_report",
        "feedback",
        "question"
      ],
      "default": "idea"
    },
    "description": {
      "type": "string"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "file_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "file_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "submitted_by_name": {
      "type": "string"
    },
    "submitted_by_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "under_review",
        "planned",
        "completed",
        "declined"
      ],
      "default": "open"
    },
    "admin_notes": {
      "type": "string"
    },
    "upvotes": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "category"
  ]
}