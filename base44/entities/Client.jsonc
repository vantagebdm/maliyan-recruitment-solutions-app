{
  "name": "Client",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string"
    },
    "abn": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "primary_contact_name": {
      "type": "string"
    },
    "primary_contact_email": {
      "type": "string"
    },
    "primary_contact_phone": {
      "type": "string"
    },
    "billing_address": {
      "type": "string"
    },
    "site_locations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approved_rates": {
      "type": "string",
      "description": "JSON or description of approved rates"
    },
    "payment_terms": {
      "type": "string"
    },
    "account_manager": {
      "type": "string",
      "description": "Internal Maliyan account manager responsible for this client"
    },
    "website": {
      "type": "string"
    },
    "invoicing_requirements": {
      "type": "string",
      "description": "Special invoicing requirements e.g. PO numbers, split invoicing"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "prospect"
      ],
      "default": "active"
    },
    "logo_url": {
      "type": "string"
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "primary",
              "accounts",
              "recruitment",
              "timesheet",
              "site",
              "other"
            ]
          }
        }
      }
    },
    "client_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "e.g. Client Agreement, Public Liability Insurance, WHS Policy"
          },
          "document_name": {
            "type": "string"
          },
          "file_url": {
            "type": "string"
          },
          "uploaded_date": {
            "type": "string",
            "format": "date"
          },
          "expiry_date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "client_activities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "call",
              "email",
              "change",
              "note",
              "meeting"
            ]
          },
          "description": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "company_name"
  ]
}