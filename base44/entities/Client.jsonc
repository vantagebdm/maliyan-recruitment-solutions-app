{
  "name": "Client",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string"
    },
    "trading_name": {
      "type": "string"
    },
    "client_id": {
      "type": "string",
      "description": "Display ID e.g. CLI-00012"
    },
    "abn": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "primary_contact_name": {
      "type": "string"
    },
    "primary_contact_email": {
      "type": "string"
    },
    "primary_contact_phone": {
      "type": "string"
    },
    "billing_address": {
      "type": "string"
    },
    "site_address": {
      "type": "string"
    },
    "site_locations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "primary_worksite": {
      "type": "string"
    },
    "standard_roster": {
      "type": "string"
    },
    "standard_shift_hours": {
      "type": "string"
    },
    "employment_types_supplied": {
      "type": "string"
    },
    "timesheet_frequency": {
      "type": "string"
    },
    "timesheet_approver": {
      "type": "string"
    },
    "invoice_frequency": {
      "type": "string"
    },
    "po_required": {
      "type": "boolean",
      "default": false
    },
    "site_induction_requirements": {
      "type": "string"
    },
    "approved_rates": {
      "type": "string",
      "description": "JSON or description of approved rates"
    },
    "payment_terms": {
      "type": "string"
    },
    "invoicing_requirements": {
      "type": "string",
      "description": "Special invoicing requirements e.g. PO numbers, split invoicing"
    },
    "account_manager": {
      "type": "string",
      "description": "Internal Maliyan account manager responsible for this client"
    },
    "website": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "prospect"
      ],
      "default": "active"
    },
    "logo_url": {
      "type": "string"
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "primary",
              "accounts",
              "recruitment",
              "timesheet",
              "site",
              "other"
            ]
          }
        }
      }
    },
    "client_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "e.g. Client Agreement, Public Liability Insurance, WHS Policy"
          },
          "document_name": {
            "type": "string"
          },
          "file_url": {
            "type": "string"
          },
          "uploaded_date": {
            "type": "string",
            "format": "date"
          },
          "expiry_date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "client_compliance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string"
          },
          "reference_number": {
            "type": "string"
          },
          "expiry_date": {
            "type": "string",
            "format": "date"
          },
          "date_verified": {
            "type": "string",
            "format": "date"
          },
          "verified_by": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "pending",
              "expired",
              "not_required"
            ],
            "default": "pending"
          }
        }
      }
    },
    "client_comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "author_name": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      }
    },
    "client_activities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "company_name"
  ]
}