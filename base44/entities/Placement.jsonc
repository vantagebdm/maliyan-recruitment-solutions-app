{
  "name": "Placement",
  "type": "object",
  "properties": {
    "candidate_id": {
      "type": "string"
    },
    "candidate_name": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "site": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "pay_rate": {
      "type": "number"
    },
    "charge_rate": {
      "type": "number"
    },
    "roster": {
      "type": "string"
    },
    "purchase_order": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "completed",
        "terminated",
        "on_hold"
      ],
      "default": "pending"
    }
  },
  "required": [
    "candidate_id",
    "job_id",
    "client_id"
  ]
}