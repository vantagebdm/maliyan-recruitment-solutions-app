{
  "name": "Application",
  "type": "object",
  "properties": {
    "candidate_id": {
      "type": "string"
    },
    "candidate_name": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "cover_letter": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "reviewing",
        "shortlisted",
        "interview",
        "offered",
        "accepted",
        "rejected",
        "withdrawn"
      ],
      "default": "submitted"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "candidate_id",
    "job_id"
  ]
}