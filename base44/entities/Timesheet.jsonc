{
  "name": "Timesheet",
  "type": "object",
  "properties": {
    "candidate_id": {
      "type": "string"
    },
    "candidate_name": {
      "type": "string"
    },
    "placement_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "site": {
      "type": "string"
    },
    "week_ending": {
      "type": "string",
      "format": "date"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "start_time": {
            "type": "string"
          },
          "finish_time": {
            "type": "string"
          },
          "break_minutes": {
            "type": "number"
          },
          "total_hours": {
            "type": "number"
          },
          "allowances": {
            "type": "number"
          },
          "travel": {
            "type": "number"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "total_ordinary_hours": {
      "type": "number",
      "default": 0
    },
    "total_overtime_hours": {
      "type": "number",
      "default": 0
    },
    "total_allowances": {
      "type": "number",
      "default": 0
    },
    "pay_rate": {
      "type": "number"
    },
    "charge_rate": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "client_approved",
        "admin_approved",
        "rejected",
        "payroll_ready",
        "paid"
      ],
      "default": "draft"
    },
    "employee_signature": {
      "type": "boolean",
      "default": false
    },
    "client_approval": {
      "type": "boolean",
      "default": false
    },
    "admin_approval": {
      "type": "boolean",
      "default": false
    },
    "rejection_reason": {
      "type": "string"
    }
  },
  "required": [
    "candidate_id",
    "week_ending"
  ]
}